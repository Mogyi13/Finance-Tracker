{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1434;Database=FinanceTracker;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "financetracker-api",
    "Audience": "financetracker-web",
    "Key": "${JWT_KEY}",
    "ExpiresMinutes": 60
  },
  "Database": {
    "AutoMigrate": true
  }
}
