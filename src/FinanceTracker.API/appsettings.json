{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1434;Database=FinanceTracker;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "financetracker-api",
    "Audience": "financetracker-web",
    "Key": "${JWT_KEY}",
    "ExpiresMinutes": 60
  },
  "Database": {
    "AutoMigrate": true
  },
  "Categorization": {
    "Ml": {
      "AutoAssignThreshold": 0.80,
      "MediumThreshold": 0.40,
      "MinSuggestionConfidence": 0.20,
      "MinTrainingExamples": 50,
      "MinExamplesPerClass": 3,
      "MinTestExamples": 20,
      "TestFraction": 0.2,
      "Seed": 42,
      "MinAccuracy": 0.70,
      "MinMacroF1": 0.60,
      "MaxAveragePredictionMs": 50,
      "ModelDirectory": "models",
      "AdminEmails": []
    }
  }
}
