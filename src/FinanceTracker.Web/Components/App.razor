<!DOCTYPE html>
<html lang="hu">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FinanceTracker.Web.styles.css"]" />
    <ImportMap />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />

    <div id="blazor-error-ui" data-nosnippet>
        Váratlan hiba történt.
        <a href="." class="reload">Újratöltés</a>
        <span class="dismiss">🗙</span>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Az egész alkalmazás interaktív, előrenderelés nélkül: a ProtectedSessionStorage
    // (a bejelentkezési állapot tárolója) csak interaktív kapcsolaton keresztül érhető el.
    private static readonly IComponentRenderMode PageRenderMode = new InteractiveServerRenderMode(prerender: false);
}
