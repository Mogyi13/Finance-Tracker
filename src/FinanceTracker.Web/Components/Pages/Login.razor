@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject AuthApiClient Api
@inject JwtAuthenticationStateProvider Session
@inject NavigationManager Navigation

<PageTitle>Bejelentkezés</PageTitle>

<h1>Üdv újra!</h1>
<p class="auth-sub">Jelentkezz be a fiókodba a folytatáshoz.</p>

@if (Registered)
{
    <StatusMessage Kind="success">Sikeres regisztráció. Most már bejelentkezhetsz.</StatusMessage>
}

@if (_errors.Count > 0)
{
    <StatusMessage Kind="danger" Messages="_errors" />
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="email">E-mail-cím</label>
        <div class="input-icon">
            <i class="bi bi-envelope" aria-hidden="true"></i>
            <InputText id="email" class="form-control" type="email" autocomplete="email" placeholder="nev@pelda.hu" @bind-Value="_model.Email" />
        </div>
        <ValidationMessage For="() => _model.Email" />
    </div>

    <div class="mb-4">
        <label class="form-label" for="password">Jelszó</label>
        <div class="input-icon has-toggle">
            <i class="bi bi-lock" aria-hidden="true"></i>
            <InputText id="password" class="form-control" type="@(_showPassword ? "text" : "password")" autocomplete="current-password" placeholder="••••••••" @bind-Value="_model.Password" />
            <button type="button" class="icon-btn toggle-visibility" aria-label="@(_showPassword ? "Jelszó elrejtése" : "Jelszó megjelenítése")" @onclick="() => _showPassword = !_showPassword">
                <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
            </button>
        </div>
        <ValidationMessage For="() => _model.Password" />
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@_busy">
        @if (_busy)
        {
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        }
        Bejelentkezés
    </button>
</EditForm>

<p class="auth-alt">Még nincs fiókod? <a href="register">Regisztráció</a></p>

@code {
    [SupplyParameterFromQuery(Name = "registered")]
    public bool Registered { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginModel _model = new();
    private List<string> _errors = new();
    private bool _busy;
    private bool _showPassword;

    private async Task SubmitAsync()
    {
        _busy = true;
        _errors = new List<string>();

        var result = await Api.LoginAsync(new LoginCommand(_model.Email.Trim(), _model.Password));
        if (!result.IsSuccess)
        {
            _errors = result.Messages.ToList();
            _busy = false;
            return;
        }

        await Session.SignInAsync(result.Value!.AccessToken, result.Value.ExpiresAt);
        Navigation.NavigateTo(IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/");
    }

    // Csak az alkalmazáson belüli, "/"-lel kezdődő cél engedélyezett (open redirect elleni védelem).
    private static bool IsLocalUrl(string? url)
        => !string.IsNullOrEmpty(url)
           && url[0] == '/'
           && (url.Length == 1 || (url[1] != '/' && url[1] != '\\'));

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Az e-mail-cím megadása kötelező.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "A jelszó megadása kötelező.")]
        public string Password { get; set; } = string.Empty;
    }
}
