@page "/transactions"
@attribute [Authorize]
@using System.Globalization
@inject TransactionApiClient Api
@inject JwtAuthenticationStateProvider Session
@inject NavigationManager Navigation

<PageTitle>Tranzakciók</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tranzakciók</h1>
    <a class="btn btn-primary" href="transactions/new">Új tranzakció</a>
</div>

@if (Saved == "created")
{
    <div class="alert alert-success" role="status">A tranzakció rögzítése sikeres.</div>
}
else if (Saved == "updated")
{
    <div class="alert alert-success" role="status">A tranzakció módosítása sikeres.</div>
}

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_loading && _result is null)
{
    <p>Betöltés…</p>
}
else if (_result is not null)
{
    if (_result.TotalCount == 0)
    {
        <p class="text-muted">Még nincs rögzített tranzakciód. Az „Új tranzakció” gombbal vehetsz fel egyet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">
                            <button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => SortByAsync(TransactionSortField.Date)">
                                Dátum @SortIndicator(TransactionSortField.Date)
                            </button>
                        </th>
                        <th scope="col">Típus</th>
                        <th scope="col">Leírás</th>
                        <th scope="col">Kategória</th>
                        <th scope="col" class="text-end">
                            <button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => SortByAsync(TransactionSortField.Amount)">
                                Összeg @SortIndicator(TransactionSortField.Amount)
                            </button>
                        </th>
                        <th scope="col"><span class="visually-hidden">Műveletek</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in _result.Items)
                    {
                        <tr>
                            <td>@transaction.TransactionDate.ToString("yyyy. MM. dd.", Hu)</td>
                            <td>
                                @if (transaction.Type == TransactionType.Income)
                                {
                                    <span class="badge bg-success">Bevétel</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Kiadás</span>
                                }
                            </td>
                            <td>@transaction.Description</td>
                            <td>
                                @if (transaction.CategoryName is not null)
                                {
                                    <span>@transaction.CategoryName</span>
                                }
                                else
                                {
                                    <span class="text-muted">Kategorizálatlan</span>
                                }
                            </td>
                            <td class="text-end text-nowrap @(transaction.Type == TransactionType.Income ? "text-success" : "text-danger")">
                                @FormatAmount(transaction)
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"transactions/{transaction.Id}/edit")">Szerkesztés</a>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(transaction)">Törlés</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-muted">
                @_result.TotalCount tranzakció, @_result.Page. oldal / @_result.TotalPages
            </div>

            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0" for="pageSize">Oldalméret</label>
                <select id="pageSize" class="form-select form-select-sm w-auto" value="@_pageSize" @onchange="OnPageSizeChangedAsync">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>

                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_result.HasPrevious || _loading)" @onclick="PreviousPageAsync">Előző</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_result.HasNext || _loading)" @onclick="NextPageAsync">Következő</button>
            </div>
        </div>
    }
}

@if (_deleteTarget is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="deleteTitle">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="deleteTitle">Tranzakció törlése</h2>
                </div>
                <div class="modal-body">
                    <p>Biztosan törölni szeretnéd ezt a tranzakciót? A művelet nem vonható vissza.</p>
                    <p class="mb-0">
                        <strong>@_deleteTarget.TransactionDate.ToString("yyyy. MM. dd.", Hu)</strong>
                        – @FormatAmount(_deleteTarget)
                        @if (!string.IsNullOrWhiteSpace(_deleteTarget.Description))
                        {
                            <span>(@_deleteTarget.Description)</span>
                        }
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" disabled="@_deleting" @onclick="CancelDelete">Mégse</button>
                    <button type="button" class="btn btn-danger" disabled="@_deleting" @onclick="ConfirmDeleteAsync">Törlés</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Hu = new("hu-HU");

    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    private int _page = 1;
    private int _pageSize = GetTransactionsQuery.DefaultPageSize;
    private TransactionSortField _sortBy = TransactionSortField.Date;
    private SortDirection _sortDirection = SortDirection.Descending;

    private PagedResult<TransactionDto>? _result;
    private bool _loading = true;
    private string? _error;

    private TransactionDto? _deleteTarget;
    private bool _deleting;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Api.GetPageAsync(new GetTransactionsQuery
        {
            Page = _page,
            PageSize = _pageSize,
            SortBy = _sortBy,
            SortDirection = _sortDirection
        });

        if (result.IsSuccess)
        {
            _result = result.Value;

            // Ha az utolsó oldal kiürült (például törlés után), visszalépünk az új utolsó oldalra.
            if (_result!.Items.Count == 0 && _result.TotalCount > 0 && _page > 1)
            {
                _page = Math.Max(1, _result.TotalPages);
                await LoadAsync();
                return;
            }
        }
        else if (result.IsUnauthorized)
        {
            await SignOutAsync();
            return;
        }
        else
        {
            _error = string.Join(" ", result.Messages);
        }

        _loading = false;
    }

    private async Task SortByAsync(TransactionSortField field)
    {
        if (_sortBy == field)
        {
            _sortDirection = _sortDirection == SortDirection.Ascending ? SortDirection.Descending : SortDirection.Ascending;
        }
        else
        {
            _sortBy = field;
            _sortDirection = SortDirection.Descending;
        }

        _page = 1;
        await LoadAsync();
    }

    private string SortIndicator(TransactionSortField field)
        => _sortBy != field ? string.Empty : _sortDirection == SortDirection.Ascending ? "▲" : "▼";

    private async Task PreviousPageAsync()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAsync();
        }
    }

    private async Task NextPageAsync()
    {
        _page++;
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _page = 1;
            await LoadAsync();
        }
    }

    private void AskDelete(TransactionDto transaction) => _deleteTarget = transaction;

    private void CancelDelete() => _deleteTarget = null;

    // UC-08: a törlés a felhasználó megerősítése után fut le.
    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null)
        {
            return;
        }

        _deleting = true;
        var result = await Api.DeleteAsync(_deleteTarget.Id);
        _deleting = false;

        if (result.IsUnauthorized)
        {
            await SignOutAsync();
            return;
        }

        _deleteTarget = null;

        if (!result.IsSuccess)
        {
            _error = string.Join(" ", result.Messages);
            return;
        }

        await LoadAsync();
    }

    private static string FormatAmount(TransactionDto transaction)
        => $"{(transaction.Type == TransactionType.Income ? "+" : "−")}{transaction.Amount.ToString("N2", Hu)} {transaction.Currency}";

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("login");
    }
}
