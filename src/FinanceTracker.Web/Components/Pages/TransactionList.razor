@page "/transactions"
@attribute [Authorize]
@inject TransactionApiClient Api
@inject CategoryApiClient CategoriesApi
@inject CategorizationApiClient CategorizationApi
@inject JwtAuthenticationStateProvider Session
@inject NavigationManager Navigation
@inject UserDisplayState UserState

<PageTitle>Tranzakciók</PageTitle>

<PageHeader Title="Tranzakciók" Subtitle="Bevételeid és kiadásaid egy helyen, szűrhetően.">
    <Actions>
        <a class="btn btn-primary" href="transactions/new"><i class="bi bi-plus-lg" aria-hidden="true"></i> Új tranzakció</a>
    </Actions>
</PageHeader>

@if (Saved == "created")
{
    <StatusMessage Kind="success">A tranzakció rögzítése sikeres.</StatusMessage>
}
else if (Saved == "updated")
{
    <StatusMessage Kind="success">A tranzakció módosítása sikeres.</StatusMessage>
}

@if (_notice is not null)
{
    <StatusMessage Kind="success">@_notice</StatusMessage>
}

@if (_error is not null)
{
    <StatusMessage Kind="danger">@_error</StatusMessage>
}

@if (_hasAnyTransaction || _applied.IsActive)
{
    <div class="ft-card filter-card">
        <button type="button" class="filter-toggle" aria-expanded="@_filtersOpen.ToString().ToLowerInvariant()" aria-controls="filter-form" @onclick="() => _filtersOpen = !_filtersOpen">
            <i class="bi bi-funnel" aria-hidden="true"></i>
            <span>Szűrők</span>
            @if (_applied.ActiveCount > 0)
            {
                <span class="filter-badge" title="Aktív szűrők száma">@_applied.ActiveCount</span>
            }
            <i class="bi @(_filtersOpen ? "bi-chevron-up" : "bi-chevron-down") ms-auto" aria-hidden="true"></i>
        </button>

        @if (_filtersOpen)
        {
            <EditForm id="filter-form" Model="_filter" OnValidSubmit="ApplyFilterAsync" class="filter-body">
                <DataAnnotationsValidator />

                <div class="filter-grid">
                    <div class="filter-wide">
                        <label class="form-label" for="f-search">Leírás tartalmazza</label>
                        <div class="input-icon">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <InputText id="f-search" class="form-control" placeholder="Például: bevásárlás" @bind-Value="_filter.Search" />
                        </div>
                        <ValidationMessage For="() => _filter.Search" />
                    </div>

                    <div>
                        <label class="form-label" for="f-type">Típus</label>
                        <InputSelect id="f-type" class="form-select" @bind-Value="_filter.TypeKey">
                            <option value="">Mind</option>
                            <option value="Income">Bevétel</option>
                            <option value="Expense">Kiadás</option>
                        </InputSelect>
                    </div>

                    <div>
                        <label class="form-label" for="f-category">Kategória</label>
                        <InputSelect id="f-category" class="form-select" @bind-Value="_filter.CategoryKey">
                            <option value="">Mind</option>
                            <optgroup label="Kiadás">
                                @foreach (var category in _categories.Where(c => c.Type == CategoryType.Expense))
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </optgroup>
                            <optgroup label="Bevétel">
                                @foreach (var category in _categories.Where(c => c.Type == CategoryType.Income))
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </optgroup>
                        </InputSelect>
                    </div>

                    <div>
                        <label class="form-label" for="f-from">Dátum -tól</label>
                        <InputDate id="f-from" class="form-control" @bind-Value="_filter.DateFrom" />
                    </div>

                    <div>
                        <label class="form-label" for="f-to">Dátum -ig</label>
                        <InputDate id="f-to" class="form-control" @bind-Value="_filter.DateTo" />
                        <ValidationMessage For="() => _filter.DateTo" />
                    </div>

                    <div>
                        <label class="form-label" for="f-min">Összeg -tól</label>
                        <InputNumber id="f-min" class="form-control" step="0.01" min="0" placeholder="0,00" @bind-Value="_filter.MinAmount" />
                        <ValidationMessage For="() => _filter.MinAmount" />
                    </div>

                    <div>
                        <label class="form-label" for="f-max">Összeg -ig</label>
                        <InputNumber id="f-max" class="form-control" step="0.01" min="0" placeholder="0,00" @bind-Value="_filter.MaxAmount" />
                        <ValidationMessage For="() => _filter.MaxAmount" />
                    </div>
                </div>

                <div class="filter-actions">
                    <button type="button" class="btn btn-outline-secondary" disabled="@(!_filter.IsActive && !_applied.IsActive)" @onclick="ClearFilterAsync">
                        <i class="bi bi-x-lg" aria-hidden="true"></i> Szűrők törlése
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@_loading">
                        <i class="bi bi-funnel" aria-hidden="true"></i> Szűrés
                    </button>
                </div>
            </EditForm>
        }
    </div>
}

<div class="ft-card">
    @if (_loading && _result is null)
    {
        <LoadingState />
    }
    else if (_result is not null)
    {
        if (_result.TotalCount == 0 && _applied.IsActive)
        {
            <EmptyState Icon="bi-funnel" Title="Nincs a szűrésnek megfelelő tranzakció" Text="Próbálj meg kevesebb vagy tágabb szűrőt megadni.">
                <button type="button" class="btn btn-outline-primary" @onclick="ClearFilterAsync">Szűrők törlése</button>
            </EmptyState>
        }
        else if (_result.TotalCount == 0)
        {
            <EmptyState Icon="bi-receipt" Title="Még nincs rögzített tranzakciód" Text="Vedd fel az első bevételedet vagy kiadásodat, és itt fogod látni az összes tételt.">
                <a class="btn btn-primary" href="transactions/new"><i class="bi bi-plus-lg" aria-hidden="true"></i> Új tranzakció</a>
            </EmptyState>
        }
        else
        {
            <div class="table-responsive">
                <table class="ft-table">
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="@(AriaSort(TransactionSortField.Date) ?? "none")">
                                <button type="button" class="th-sort @(_sortBy == TransactionSortField.Date ? "is-active" : null)" @onclick="() => SortByAsync(TransactionSortField.Date)">
                                    Dátum
                                    @if (_sortBy == TransactionSortField.Date)
                                    {
                                        <i class="bi @SortIcon(TransactionSortField.Date)" aria-hidden="true"></i>
                                    }
                                </button>
                            </th>
                            <th scope="col">Tranzakció</th>
                            <th scope="col">Kategória</th>
                            <th scope="col" class="text-end" aria-sort="@(AriaSort(TransactionSortField.Amount) ?? "none")">
                                <button type="button" class="th-sort @(_sortBy == TransactionSortField.Amount ? "is-active" : null)" @onclick="() => SortByAsync(TransactionSortField.Amount)">
                                    Összeg
                                    @if (_sortBy == TransactionSortField.Amount)
                                    {
                                        <i class="bi @SortIcon(TransactionSortField.Amount)" aria-hidden="true"></i>
                                    }
                                </button>
                            </th>
                            <th scope="col" class="col-actions"><span class="visually-hidden">Műveletek</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in _result.Items)
                        {
                            var income = transaction.Type == TransactionType.Income;
                            <tr>
                                <td class="date-cell">@TransactionFormat.Date(transaction.TransactionDate)</td>
                                <td>
                                    <div class="tx-cell">
                                        <span class="tx-icon @(income ? "tx-icon-income" : "tx-icon-expense")">
                                            <i class="bi @(income ? "bi-arrow-down-left" : "bi-arrow-up-right")" aria-hidden="true"></i>
                                        </span>
                                        <div>
                                            <div class="tx-title">@(string.IsNullOrWhiteSpace(transaction.Description) ? (income ? "Bevétel" : "Kiadás") : transaction.Description)</div>
                                            <div class="tx-sub">@(income ? "Bevétel" : "Kiadás")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (transaction.CategoryName is not null)
                                    {
                                        <span class="chip" title="@StatusHint(transaction.CategorizationStatus)">
                                            @transaction.CategoryName
                                            @if (transaction.CategorizationStatus == CategorizationStatus.RuleBased)
                                            {
                                                <i class="bi bi-magic" aria-hidden="true"></i>
                                            }
                                            else if (transaction.CategorizationStatus == CategorizationStatus.MachineLearning)
                                            {
                                                <i class="bi bi-stars" aria-hidden="true"></i>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-muted">Kategorizálatlan</span>
                                    }
                                </td>
                                <td class="text-end amount @(income ? "amount-income" : "amount-expense")">@TransactionFormat.Amount(transaction)</td>
                                <td class="col-actions">
                                    <button type="button" class="icon-btn" title="Kategória javítása" aria-label="Kategória javítása" @onclick="() => AskCorrect(transaction)"><i class="bi bi-tags" aria-hidden="true"></i></button>
                                    <a class="icon-btn" title="Szerkesztés" aria-label="Szerkesztés" href="@($"transactions/{transaction.Id}/edit")"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <button type="button" class="icon-btn danger" title="Törlés" aria-label="Törlés" @onclick="() => AskDelete(transaction)"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ft-card-footer">
                <div class="text-muted">
                    @_result.TotalCount @(_applied.IsActive ? "találat" : "tranzakció") · @_result.Page. oldal / @_result.TotalPages
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="page-size">
                        <label for="pageSize">Oldalméret</label>
                        <select id="pageSize" class="form-select form-select-sm" value="@_pageSize" @onchange="OnPageSizeChangedAsync">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </div>

                    <div class="pager">
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_result.HasPrevious || _loading)" @onclick="PreviousPageAsync"><i class="bi bi-chevron-left" aria-hidden="true"></i> Előző</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_result.HasNext || _loading)" @onclick="NextPageAsync">Következő <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (_correctTarget is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="correctTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body p-4">
                    <span class="modal-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
                    <h2 class="h5 mb-2" id="correctTitle">Kategória javítása</h2>
                    <p class="text-muted">
                        @(string.IsNullOrWhiteSpace(_correctTarget.Description) ? "Tranzakció" : _correctTarget.Description)
                        – @TransactionFormat.Amount(_correctTarget)
                    </p>

                    @if (_correctError is not null)
                    {
                        <StatusMessage Kind="danger">@_correctError</StatusMessage>
                    }

                    <label class="form-label" for="correct-category">Kategória</label>
                    <select id="correct-category" class="form-select" @bind="_correctChoice">
                        <option value="">Válassz kategóriát…</option>
                        @foreach (var category in _categories.Where(c => (byte)c.Type == (byte)_correctTarget.Type))
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <div class="form-text">A kézi besorolás felülírja az automatikus javaslatot, és a modell későbbi értékeléséhez megmarad.</div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-outline-secondary" disabled="@_correcting" @onclick="CancelCorrect">Mégse</button>
                    <button type="button" class="btn btn-primary" disabled="@(_correcting || string.IsNullOrEmpty(_correctChoice))" @onclick="ConfirmCorrectAsync">
                        @if (_correcting)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        }
                        Mentés
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_deleteTarget is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="deleteTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body p-4">
                    <span class="modal-icon"><i class="bi bi-trash3" aria-hidden="true"></i></span>
                    <h2 class="h5 mb-2" id="deleteTitle">Tranzakció törlése</h2>
                    <p class="text-muted">Biztosan törölni szeretnéd ezt a tranzakciót? A művelet nem vonható vissza.</p>
                    <p class="mb-0">
                        <strong>@TransactionFormat.Date(_deleteTarget.TransactionDate)</strong>
                        – @TransactionFormat.Amount(_deleteTarget)
                        @if (!string.IsNullOrWhiteSpace(_deleteTarget.Description))
                        {
                            <span class="text-muted">(@_deleteTarget.Description)</span>
                        }
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-outline-secondary" disabled="@_deleting" @onclick="CancelDelete">Mégse</button>
                    <button type="button" class="btn btn-danger" disabled="@_deleting" @onclick="ConfirmDeleteAsync">
                        @if (_deleting)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        }
                        Törlés
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    private int _page = 1;
    private int _pageSize = GetTransactionsQuery.DefaultPageSize;
    private TransactionSortField _sortBy = TransactionSortField.Date;
    private SortDirection _sortDirection = SortDirection.Descending;

    // UC-09: az űrlap szerkesztett állapota (_filter) és az éppen érvényes szűrő (_applied) külön él,
    // így a lapozás és a rendezés mindig az utoljára alkalmazott szűrővel történik.
    private TransactionFilterModel _filter = new();
    private TransactionFilterModel _applied = new();
    private List<CategoryDto> _categories = new();
    private bool _filtersOpen = true;
    private bool _hasAnyTransaction;

    private PagedResult<TransactionDto>? _result;
    private bool _loading = true;
    private string? _error;

    private TransactionDto? _deleteTarget;
    private bool _deleting;

    // UC-17: kézi kategóriajavítás
    private TransactionDto? _correctTarget;
    private string _correctChoice = string.Empty;
    private bool _correcting;
    private string? _correctError;
    private string? _notice;

    protected override async Task OnInitializedAsync()
    {
        // A kategóriák csak a szűrő választójához kellenek; hiba esetén a szűrő kategória nélkül is használható.
        var categories = await CategoriesApi.GetAllAsync();
        if (categories.IsSuccess)
        {
            _categories = categories.Value!;
        }

        await LoadAsync();
    }

    private async Task ApplyFilterAsync()
    {
        _applied = _filter.Clone();
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFilterAsync()
    {
        _filter = new TransactionFilterModel();
        _applied = new TransactionFilterModel();
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Api.GetPageAsync(_applied.ToQuery(_page, _pageSize, _sortBy, _sortDirection));

        if (result.IsSuccess)
        {
            _result = result.Value;

            // Szűrő nélkül a teljes lista összesítője mutatja, hogy van-e egyáltalán tranzakció (a szűrőpanel megjelenítéséhez).
            if (!_applied.IsActive)
            {
                _hasAnyTransaction = _result!.TotalCount > 0;
            }
            else if (_result!.TotalCount > 0)
            {
                _hasAnyTransaction = true;
            }

            // Ha az utolsó oldal kiürült (például törlés után), visszalépünk az új utolsó oldalra.
            if (_result!.Items.Count == 0 && _result.TotalCount > 0 && _page > 1)
            {
                _page = Math.Max(1, _result.TotalPages);
                await LoadAsync();
                return;
            }
        }
        else if (result.IsUnauthorized)
        {
            await SignOutAsync();
            return;
        }
        else
        {
            _error = string.Join(" ", result.Messages);
        }

        _loading = false;
    }

    private async Task SortByAsync(TransactionSortField field)
    {
        if (_sortBy == field)
        {
            _sortDirection = _sortDirection == SortDirection.Ascending ? SortDirection.Descending : SortDirection.Ascending;
        }
        else
        {
            _sortBy = field;
            _sortDirection = SortDirection.Descending;
        }

        _page = 1;
        await LoadAsync();
    }

    private string SortIcon(TransactionSortField field)
        => _sortDirection == SortDirection.Ascending ? "bi-arrow-up" : "bi-arrow-down";

    private string? AriaSort(TransactionSortField field)
        => _sortBy != field ? null : _sortDirection == SortDirection.Ascending ? "ascending" : "descending";

    private async Task PreviousPageAsync()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAsync();
        }
    }

    private async Task NextPageAsync()
    {
        _page++;
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _page = 1;
            await LoadAsync();
        }
    }

    private static string? StatusHint(CategorizationStatus status) => status switch
    {
        CategorizationStatus.RuleBased => "Szabály alapján kategorizálva",
        CategorizationStatus.MachineLearning => "Modell alapján kategorizálva",
        CategorizationStatus.ManuallyAssigned => "Kézzel kategorizálva",
        _ => null
    };

    private void AskCorrect(TransactionDto transaction)
    {
        _correctTarget = transaction;
        _correctChoice = transaction.CategoryId?.ToString() ?? string.Empty;
        _correctError = null;
    }

    private void CancelCorrect() => _correctTarget = null;

    private async Task ConfirmCorrectAsync()
    {
        if (_correctTarget is null || !Guid.TryParse(_correctChoice, out var categoryId))
        {
            return;
        }

        _correcting = true;
        _correctError = null;
        var result = await CategorizationApi.SubmitFeedbackAsync(_correctTarget.Id, categoryId);
        _correcting = false;

        if (result.IsUnauthorized)
        {
            await SignOutAsync();
            return;
        }

        if (!result.IsSuccess)
        {
            _correctError = string.Join(" ", result.Messages);
            return;
        }

        _correctTarget = null;
        _notice = $"A kategória mentve: {result.Value!.CategoryName}.";
        await LoadAsync();
    }

    private void AskDelete(TransactionDto transaction) => _deleteTarget = transaction;

    private void CancelDelete() => _deleteTarget = null;

    // UC-08: a törlés a felhasználó megerősítése után fut le.
    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null)
        {
            return;
        }

        _deleting = true;
        var result = await Api.DeleteAsync(_deleteTarget.Id);
        _deleting = false;

        if (result.IsUnauthorized)
        {
            await SignOutAsync();
            return;
        }

        _deleteTarget = null;

        if (!result.IsSuccess)
        {
            _error = string.Join(" ", result.Messages);
            return;
        }

        await LoadAsync();
    }

    private async Task SignOutAsync()
    {
        UserState.Set(null);
        await Session.SignOutAsync();
        Navigation.NavigateTo("login");
    }
}
