@page "/Error"
@using System.Diagnostics

<PageTitle>Hiba</PageTitle>

<div class="ft-card">
    <EmptyState Icon="bi-exclamation-triangle" Title="Hiba történt" Text="A kérés feldolgozása közben váratlan hiba lépett fel. Kérjük, próbáld újra később.">
        @if (ShowRequestId)
        {
            <p class="text-muted small mb-3">Kérés azonosítója: <code>@RequestId</code></p>
        }
        <a class="btn btn-primary" href="">Vissza a kezdőlapra</a>
    </EmptyState>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
