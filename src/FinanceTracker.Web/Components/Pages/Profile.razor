@page "/profile"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject AuthApiClient Api
@inject JwtAuthenticationStateProvider Session
@inject NavigationManager Navigation
@inject UserDisplayState UserState

<PageTitle>Profil</PageTitle>

<PageHeader Title="Profil" Subtitle="A fiókod adatai és a megjelenített neved." />

@if (_loading)
{
    <LoadingState />
}
else if (_user is null)
{
    <StatusMessage Kind="danger">@(_errors.FirstOrDefault() ?? "A profil nem tölthető be.")</StatusMessage>
}
else
{
    <div class="ft-card" style="max-width: 640px;">
        <div class="ft-card-body">
            <div class="profile-head">
                <UserAvatar Name="@_user.DisplayName" Large="true" />
                <div>
                    <h2>@_user.DisplayName</h2>
                    <p>@_user.Email</p>
                </div>
            </div>

            @if (_saved)
            {
                <StatusMessage Kind="success">A profil módosítása sikeres.</StatusMessage>
            }

            @if (_errors.Count > 0)
            {
                <StatusMessage Kind="danger" Messages="_errors" />
            }

            <EditForm Model="_model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="email">E-mail-cím</label>
                    <input id="email" class="form-control" value="@_user.Email" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="displayName">Megjelenítendő név</label>
                    <InputText id="displayName" class="form-control" @bind-Value="_model.DisplayName" />
                    <ValidationMessage For="() => _model.DisplayName" />
                </div>

                <p class="text-muted mb-4">
                    <i class="bi bi-calendar-check me-1" aria-hidden="true"></i>
                    Regisztráció: @_user.CreatedAt.ToLocalTime().ToString("yyyy. MM. dd. HH:mm", TransactionFormat.Hu)
                </p>

                <button type="submit" class="btn btn-primary" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    Mentés
                </button>
            </EditForm>
        </div>
    </div>
}

@code {
    private readonly ProfileModel _model = new();
    private UserProfileDto? _user;
    private List<string> _errors = new();
    private bool _loading = true;
    private bool _busy;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetMeAsync();
        if (result.IsSuccess)
        {
            _user = result.Value;
            _model.DisplayName = _user!.DisplayName;
            UserState.Set(_user.DisplayName);
        }
        else if (result.IsUnauthorized)
        {
            await SignOutAndRedirectAsync();
            return;
        }
        else
        {
            _errors = result.Messages.ToList();
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _saved = false;
        _errors = new List<string>();

        var result = await Api.UpdateProfileAsync(new UpdateProfileCommand(_model.DisplayName.Trim()));
        if (result.IsSuccess)
        {
            _user = result.Value;
            _model.DisplayName = _user!.DisplayName;
            UserState.Set(_user.DisplayName);
            _saved = true;
        }
        else if (result.IsUnauthorized)
        {
            await SignOutAndRedirectAsync();
            return;
        }
        else
        {
            _errors = result.Messages.ToList();
        }

        _busy = false;
    }

    private async Task SignOutAndRedirectAsync()
    {
        UserState.Set(null);
        await Session.SignOutAsync();
        Navigation.NavigateTo("login");
    }

    private sealed class ProfileModel
    {
        [Required(ErrorMessage = "A megjelenítendő név megadása kötelező.")]
        [StringLength(100, ErrorMessage = "A megjelenítendő név legfeljebb 100 karakter lehet.")]
        public string DisplayName { get; set; } = string.Empty;
    }
}
