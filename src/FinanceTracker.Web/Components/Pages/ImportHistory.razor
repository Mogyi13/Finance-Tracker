@page "/imports"
@attribute [Authorize]
@inject ImportApiClient Api
@inject JwtAuthenticationStateProvider Session
@inject NavigationManager Navigation
@inject UserDisplayState UserState

<PageTitle>Importok</PageTitle>

<PageHeader Title="Importok" Subtitle="A korábbi CSV-importjaid eredménye, a legutóbbi elöl.">
    <Actions>
        <a class="btn btn-primary" href="import"><i class="bi bi-upload" aria-hidden="true"></i> Új import</a>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <StatusMessage Kind="danger">@_error</StatusMessage>
}

<div class="ft-card">
    @if (_loading && _result is null)
    {
        <LoadingState />
    }
    else if (_result is not null)
    {
        if (_result.TotalCount == 0)
        {
            <EmptyState Icon="bi-cloud-arrow-up" Title="Még nem importáltál fájlt" Text="Tölts fel egy CSV-fájlt, és az eredménye itt lesz visszakereshető.">
                <a class="btn btn-primary" href="import"><i class="bi bi-upload" aria-hidden="true"></i> Első import indítása</a>
            </EmptyState>
        }
        else
        {
            <div class="table-responsive">
                <table class="ft-table">
                    <thead>
                        <tr>
                            <th scope="col">Időpont</th>
                            <th scope="col">Fájl</th>
                            <th scope="col">Állapot</th>
                            <th scope="col" class="text-end">Sorok</th>
                            <th scope="col" class="text-end">Importálva</th>
                            <th scope="col" class="text-end">Hibás</th>
                            <th scope="col" class="text-end">Duplikátum</th>
                            <th scope="col" class="col-actions"><span class="visually-hidden">Részletek</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in _result.Items)
                        {
                            <tr>
                                <td class="date-cell">@batch.CreatedAt.ToLocalTime().ToString("yyyy. MM. dd. HH:mm", TransactionFormat.Hu)</td>
                                <td><a class="file-link" href="@($"imports/{batch.Id}")"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> @batch.FileName</a></td>
                                <td><ImportStatusChip Status="batch.Status" /></td>
                                <td class="text-end">@batch.TotalRows.ToString("N0", TransactionFormat.Hu)</td>
                                <td class="text-end">@batch.SuccessfulRows.ToString("N0", TransactionFormat.Hu)</td>
                                <td class="text-end @(batch.FailedRows > 0 ? "text-danger fw-semibold" : null)">@batch.FailedRows.ToString("N0", TransactionFormat.Hu)</td>
                                <td class="text-end">@batch.DuplicateRows.ToString("N0", TransactionFormat.Hu)</td>
                                <td class="col-actions">
                                    <a class="icon-btn" title="Részletek" aria-label="@($"{batch.FileName} részletei")" href="@($"imports/{batch.Id}")"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ft-card-footer">
                <div class="text-muted">@_result.TotalCount import · @_result.Page. oldal / @_result.TotalPages</div>
                <div class="pager">
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_result.HasPrevious || _loading)" @onclick="PreviousPageAsync"><i class="bi bi-chevron-left" aria-hidden="true"></i> Előző</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_result.HasNext || _loading)" @onclick="NextPageAsync">Következő <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>
        }
    }
</div>

@code {
    private const int PageSize = 10;

    private PagedResult<ImportBatchDto>? _result;
    private string? _error;
    private int _page = 1;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Api.GetPageAsync(_page, PageSize);
        if (result.IsUnauthorized)
        {
            await SignOutAsync();
            return;
        }

        if (result.IsSuccess)
        {
            _result = result.Value;
        }
        else
        {
            _error = string.Join(" ", result.Messages);
        }

        _loading = false;
    }

    private async Task PreviousPageAsync()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAsync();
        }
    }

    private async Task NextPageAsync()
    {
        _page++;
        await LoadAsync();
    }

    private async Task SignOutAsync()
    {
        UserState.Set(null);
        await Session.SignOutAsync();
        Navigation.NavigateTo("login");
    }
}
