@page "/"
@using System.Net
@inject JwtAuthenticationStateProvider Session
@inject AuthApiClient Api

<PageTitle>Finance Tracker</PageTitle>

@if (_loading)
{
    <p>Betöltés…</p>
}
else if (_user is null)
{
    <h1>Finance Tracker</h1>
    <p class="lead">Személyes pénzügyek követése egy helyen.</p>
    <p>
        <a class="btn btn-primary me-2" href="login">Bejelentkezés</a>
        <a class="btn btn-outline-primary" href="register">Regisztráció</a>
    </p>
}
else
{
    <h1>Üdv, @_user.DisplayName!</h1>
    <p class="text-muted">Ez a kezdőlap. A pénzügyi áttekintés a következő használati esetekkel bővül.</p>
}

@code {
    private bool _loading = true;
    private UserProfileDto? _user;

    protected override async Task OnInitializedAsync()
    {
        var state = await Session.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var result = await Api.GetMeAsync();
            if (result.IsSuccess)
            {
                _user = result.Value;
            }
            else if (result.IsUnauthorized)
            {
                // Lejárt vagy érvénytelen token: töröljük a hitelesítési állapotot.
                await Session.SignOutAsync();
            }
        }

        _loading = false;
    }
}
