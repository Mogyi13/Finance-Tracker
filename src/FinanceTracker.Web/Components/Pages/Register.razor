@page "/register"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject AuthApiClient Api
@inject NavigationManager Navigation

<PageTitle>Regisztráció</PageTitle>

<h1>Fiók létrehozása</h1>
<p class="auth-sub">Pár adat, és már rögzítheted is az első tranzakciódat.</p>

@if (_errors.Count > 0)
{
    <StatusMessage Kind="danger" Messages="_errors" />
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="email">E-mail-cím</label>
        <div class="input-icon">
            <i class="bi bi-envelope" aria-hidden="true"></i>
            <InputText id="email" class="form-control" type="email" autocomplete="email" placeholder="nev@pelda.hu" @bind-Value="_model.Email" />
        </div>
        <ValidationMessage For="() => _model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="displayName">Megjelenítendő név</label>
        <div class="input-icon">
            <i class="bi bi-person" aria-hidden="true"></i>
            <InputText id="displayName" class="form-control" autocomplete="name" placeholder="Kovács Anna" @bind-Value="_model.DisplayName" />
        </div>
        <ValidationMessage For="() => _model.DisplayName" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="password">Jelszó</label>
        <div class="input-icon has-toggle">
            <i class="bi bi-lock" aria-hidden="true"></i>
            <InputText id="password" class="form-control" type="@(_showPassword ? "text" : "password")" autocomplete="new-password" @bind-Value="_model.Password" />
            <button type="button" class="icon-btn toggle-visibility" aria-label="@(_showPassword ? "Jelszó elrejtése" : "Jelszó megjelenítése")" @onclick="() => _showPassword = !_showPassword">
                <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
            </button>
        </div>
        <div class="form-text">Legalább 8 karakter, kis- és nagybetűvel, számjeggyel.</div>
        <ValidationMessage For="() => _model.Password" />
    </div>

    <div class="mb-4">
        <label class="form-label" for="confirmPassword">Jelszó megerősítése</label>
        <div class="input-icon">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <InputText id="confirmPassword" class="form-control" type="@(_showPassword ? "text" : "password")" autocomplete="new-password" @bind-Value="_model.ConfirmPassword" />
        </div>
        <ValidationMessage For="() => _model.ConfirmPassword" />
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@_busy">
        @if (_busy)
        {
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        }
        Regisztráció
    </button>
</EditForm>

<p class="auth-alt">Már van fiókod? <a href="login">Bejelentkezés</a></p>

@code {
    private readonly RegisterModel _model = new();
    private List<string> _errors = new();
    private bool _busy;
    private bool _showPassword;

    private async Task SubmitAsync()
    {
        _busy = true;
        _errors = new List<string>();

        var result = await Api.RegisterAsync(new RegisterCommand(_model.Email.Trim(), _model.DisplayName.Trim(), _model.Password));
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("login?registered=true");
            return;
        }

        _errors = result.Messages.ToList();
        _busy = false;
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Az e-mail-cím megadása kötelező.")]
        [EmailAddress(ErrorMessage = "Az e-mail-cím formátuma érvénytelen.")]
        [StringLength(256, ErrorMessage = "Az e-mail-cím legfeljebb 256 karakter lehet.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "A megjelenítendő név megadása kötelező.")]
        [StringLength(100, ErrorMessage = "A megjelenítendő név legfeljebb 100 karakter lehet.")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "A jelszó megadása kötelező.")]
        [MinLength(8, ErrorMessage = "A jelszó legalább 8 karakter hosszú legyen.")]
        [StringLength(128, ErrorMessage = "A jelszó legfeljebb 128 karakter lehet.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "A jelszó megerősítése kötelező.")]
        [Compare(nameof(Password), ErrorMessage = "A két jelszó nem egyezik.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
