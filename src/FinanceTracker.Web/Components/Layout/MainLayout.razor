@inherits LayoutComponentBase
@inject JwtAuthenticationStateProvider Session
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LogoutAsync">Kijelentkezés</button>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="me-3">Bejelentkezés</a>
                    <a href="register">Regisztráció</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Váratlan hiba történt.
    <a href="." class="reload">Újratöltés</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // UC-03: kijelentkezés
    private async Task LogoutAsync()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("login");
    }
}
