@inject ModelAdminApiClient ModelAdmin

<a class="brand" href="">
    <BrandMark />
    <span>Finance Tracker</span>
</a>

<div class="side-cta">
    <a class="btn btn-primary" href="transactions/new">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Új tranzakció
    </a>
</div>

<nav class="side-nav" aria-label="Főmenü">
    <div class="side-section">Áttekintés</div>
    <NavLink class="side-link" href="" Match="NavLinkMatch.All">
        <i class="bi bi-grid-1x2" aria-hidden="true"></i> Kezdőlap
    </NavLink>

    <div class="side-section">Pénzügyek</div>
    <NavLink class="side-link" href="transactions">
        <i class="bi bi-receipt" aria-hidden="true"></i> Tranzakciók
    </NavLink>
    <NavLink class="side-link" href="categories">
        <i class="bi bi-tags" aria-hidden="true"></i> Kategóriák
    </NavLink>
    <NavLink class="side-link" href="import" Match="NavLinkMatch.All">
        <i class="bi bi-upload" aria-hidden="true"></i> CSV-import
    </NavLink>
    <NavLink class="side-link" href="imports">
        <i class="bi bi-clock-history" aria-hidden="true"></i> Importok
    </NavLink>
    <NavLink class="side-link" href="rules">
        <i class="bi bi-magic" aria-hidden="true"></i> Szabályok
    </NavLink>
    <NavLink class="side-link" href="suggestions">
        <i class="bi bi-lightbulb" aria-hidden="true"></i> Javaslatok
    </NavLink>

    <div class="side-section">Elemzés</div>
    <NavLink class="side-link" href="analytics" Match="NavLinkMatch.All">
        <i class="bi bi-bar-chart" aria-hidden="true"></i> Áttekintés
    </NavLink>
    <NavLink class="side-link" href="analytics/compare">
        <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Összehasonlítás
    </NavLink>
    <NavLink class="side-link" href="recurring">
        <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Ismétlődő kiadások
    </NavLink>

    @if (_isOperator)
    {
        <div class="side-section">Üzemeltetés</div>
        <NavLink class="side-link" href="admin/models">
            <i class="bi bi-cpu" aria-hidden="true"></i> Modellkezelés
        </NavLink>
    }

    <div class="side-section">Fiók</div>
    <NavLink class="side-link" href="profile">
        <i class="bi bi-person" aria-hidden="true"></i> Profil
    </NavLink>
</nav>

<div class="side-footer">Finance Tracker · Demo verzió</div>

@code {
    private bool _isOperator;

    // A modellkezelés menüpont csak az üzemeltetőnek jelenik meg; a jogosultságot az API dönti el (másnak a végpont 403-at ad).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var access = await ModelAdmin.HasAccessAsync();
            if (access.IsSuccess)
            {
                _isOperator = true;
                StateHasChanged();
            }
        }
    }
}
